<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Loại Phần Cứng</title>
  
  <%- include('../partials/header') %>
  <div class="container mt-4">
    <h2 class="mb-3">Loại phần cứng</h2>
    <div id="hardwareTypeAlertContainer" class="mb-3"></div>

    <!-- 🔍 Form lọc -->
    <form id="filterHardwareTypeForm" class="row g-2 mb-3">
      <div class="col-6 col-md-4"><input name="code" class="form-control" placeholder="Mã loại phần cứng" /></div>
      <div class="col-6 col-md-4"><input name="name" class="form-control" placeholder="Tên loại phần cứng" /></div>
      <div class="col-6 col-md-4">
        <select name="filter" class="form-select">
          <option value="all">Tất cả</option>
          <option value="active">Hoạt động</option>
          <option value="inactive">Tạm ngưng</option>
        </select>
      </div>
      <div class="col-12 text-center text-md-end">
        <button class="btn btn-primary">Tìm kiếm</button>
        <button type="button" id="resetHardwareTypeBtn" class="btn btn-secondary ms-2">Reset</button>
        <button type="button" class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#hardwareTypeModal">➕ Thêm</button>
      </div>
    </form>

    <!-- 📋 Bảng -->
    <div id="hardwareTypeTable" class="mt-4"></div>
    <div id="hardwareTypePagination" class="mt-3 text-center"></div>
  </div>

  <!-- ✨ Modal thêm -->
  <div class="modal fade" id="hardwareTypeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <form id="createHardwareTypeForm" class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Thêm loại phần cứng</h5></div>
        <div class="modal-body">
          <input name="code" class="form-control mb-2" placeholder="Mã phần cứng" required />
          <input name="name" class="form-control mb-2" placeholder="Tên phần cứng" required />
          <input name="note" class="form-control mb-2" placeholder="Ghi chú" />
        </div>
        <div class="modal-footer">
          <button class="btn btn-success">Thêm</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/hardwareTypes.js"></script>
</body>
</html>
