<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Danh mục Phần Cứng</title>
  
  <%- include('../partials/header') %>
  <div class="container mt-4">
    <h2 class="mb-3">Phần cứng</h2>
    <div id="hardwareAlertContainer" class="mb-3"></div>

    <!-- 🔍 Bộ lọc -->
    <form id="filterHardwareForm" class="row g-2 mb-3">
      <div class="col-6 col-md-3"><input name="code" class="form-control" placeholder="Mã phần cứng" /></div>
      <div class="col-6 col-md-3"><input name="name" class="form-control" placeholder="Tên phần cứng" /></div>
      <div class="col-6 col-md-3">
        <select name="hardwareTypeId" class="form-select" id="hardwareTypeDropdown">
          <option value="">-- Loại phần cứng --</option>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <select name="filter" class="form-select">
          <option value="all">Tất cả</option>
          <option value="active">Còn sử dụng</option>
          <option value="inactive">Tạm ngưng</option>
        </select>
      </div>
      <div class="col-12 text-center text-md-end">
        <button class="btn btn-primary">Tìm kiếm</button>
        <button type="button" id="resetHardwareBtn" class="btn btn-secondary ms-2">Reset</button>
        <button type="button" class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#hardwareModal">➕ Thêm</button>
      </div>
    </form>

    <!-- 📋 Bảng phần cứng -->
    <div id="hardwareTable" class="mt-4"></div>

    <!-- 🔁 Phân trang -->
    <div id="hardwarePagination" class="mt-3 text-center"></div>
  </div>

  <!-- ➕ Modal thêm phần cứng -->
  <div class="modal fade" id="hardwareModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <form id="createHardwareForm" class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Thêm phần cứng mới</h5></div>
        <div class="modal-body">
          <input name="code" class="form-control mb-2" placeholder="Mã phần cứng" required />
          <input name="name" class="form-control mb-2" placeholder="Tên phần cứng" required />
          <select name="hardwareTypeId" class="form-select mb-2" id="modalHardwareType"></select>
          <input name="note" class="form-control mb-2" placeholder="Ghi chú" />
        </div>
        <div class="modal-footer">
          <button class="btn btn-success">Thêm</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/common/pagination.js"></script>
  <script src="/js/hardwares.js"></script>
</body>
</html>