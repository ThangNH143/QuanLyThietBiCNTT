<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Quản lý Loại Thiết bị</title>
  <%- include('../partials/header') %>

  <div class="container mt-4">
    <h2 class="mb-3">Loại thiết bị</h2>
    <div id="deviceTypeAlertContainer" class="mb-3"></div>

    <!-- 🔍 Bộ lọc -->
    <form id="filterDeviceTypeForm" class="row g-2 mb-3">
      <div class="col-6 col-md-4">
        <input name="code" class="form-control" placeholder="Mã loại thiết bị" />
      </div>
      <div class="col-6 col-md-4">
        <input name="name" class="form-control" placeholder="Tên loại thiết bị" />
      </div>
      <div class="col-6 col-md-4">
        <select name="filter" class="form-select">
          <option value="all">Tất cả</option>
          <option value="active">Hoạt động</option>
          <option value="inactive">Tạm ngưng</option>
        </select>
      </div>
      <div class="col-12 text-center text-md-end">
        <button class="btn btn-primary">Tìm kiếm</button>
        <button type="button" id="resetDeviceTypeBtn" class="btn btn-secondary ms-2">Reset</button>
        <button type="button" class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#deviceTypeModal">➕ Thêm</button>
      </div>
    </form>

    <!-- 📋 Bảng loại thiết bị -->
    <div id="deviceTypeTable" class="mt-4"></div>

    <!-- 🔄 Phân trang -->
    <div id="deviceTypePagination" class="mt-3 text-center"></div>
  </div>

  <!-- ➕ Modal tạo loại thiết bị -->
  <div class="modal fade" id="deviceTypeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <form id="createDeviceTypeForm" class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Thêm loại thiết bị</h5></div>
        <div class="modal-body">
          <input name="code" class="form-control mb-2" placeholder="Mã loại thiết bị" required />
          <input name="name" class="form-control mb-2" placeholder="Tên loại thiết bị" required />
          <input name="note" class="form-control mb-2" placeholder="Ghi chú" />
        </div>
        <div class="modal-footer">
          <button class="btn btn-success">Thêm</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/common/pagination.js"></script>
  <script src="/js/deviceTypes.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
