<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Quản lý sửa chữa thiết bị</title>

  <%- include('../partials/header') %>

<div class="container mt-4">
  <h2 class="mb-4">Quản lý sửa chữa thiết bị</h2>
  <div id="repairAlertContainer" class="mb-3"></div>

  <!-- Bộ lọc -->
  <form id="filterRepairForm" class="row g-2 mb-3">
    <div class="col-md-4"><input name="deviceKeyword" class="form-control" placeholder="Tìm thiết bị..." /></div>
    <div class="col-md-4"><input name="hardwareKeyword" class="form-control" placeholder="Tìm phần cứng..." /></div>
    <div class="col-md-4">
      <select name="status" class="form-select">
        <option value="opened">Mới tiếp nhận</option>
        <option value="in-progress">Đang sửa</option>
        <option value="completed">Hoàn tất</option>
        <option value="canceled">Hủy bỏ</option>
        <option value="all">Tất cả</option>
      </select>
    </div>
    <div class="col-md-12 text-end">
      <button class="btn btn-primary">🔍 Tìm</button>
      <button type="button" id="btnResetRepairFilter" class="btn btn-secondary ms-2">↩ Reset</button>
      <button type="button" id="btnOpenCreateRepairModal" class="btn btn-success ms-2">➕ Tạo phiếu sửa</button>
    </div>
  </form>

  <!-- Bảng danh sách -->
  <table class="table table-bordered table-striped align-middle">
    <thead>
      <tr>
        <th>Thiết bị</th>
        <th>Loại</th>
        <th>Phần cứng</th>
        <th>Khoa phòng</th>
        <th>Người gửi</th>
        <th>Ngày hư</th>
        <th>Người thực hiện</th>
        <th>Ngày sửa</th>
        <th>Trạng thái</th>
        <th>Ghi chú</th>
        <th>Thao tác</th>
      </tr>
    </thead>
    <tbody id="repairTableBody"></tbody>
  </table>

  <!-- Phân trang -->
  <div id="repairPagination" class="mt-3 d-flex justify-content-end"></div>
</div>

<!-- Modal tạo -->
<div class="modal fade" id="repairCreateModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <form id="createRepairForm" class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Tạo phiếu sửa chữa</h5></div>
      <div class="modal-body">
        <div class="mb-3">
          <label for="createRepairDeviceDropdown" class="form-label">Thiết bị</label>
          <select id="createRepairDeviceDropdown" class="form-select mb-3" required></select>
        </div>
        <div class="mb-3">
          <label for="createRepairHardwareDropdown" class="form-label">Phần cứng</label>
          <select id="createRepairHardwareDropdown" class="form-select mb-3" multiple></select>
        </div>
        <div class="mb-3">
          <label for="createRepairSenderText" class="form-label">Người gửi Thiết bị</label>
          <input id="createRepairSenderText" class="form-control mb-3" />
        </div>
        <div class="mb-3">
          <label for="repairBrokenDate" class="form-label">Ngày hư hỏng</label>
          <input type="date" id="createRepairBrokenDate" class="form-control mb-3" required />
        </div>
        <div class="mb-3">
          <label for="createRepairReceiverDropdown" class="form-label">Người nhận sửa chữa</label>
          <select id="createRepairReceiverDropdown" class="form-select mb-3"></select>
        </div>
        <div class="mb-3">
          <label for="createRepairRepairDate" class="form-label">Ngày sửa chữa</label>
          <input type="date" id="createRepairRepairDate" class="form-control mb-3" />
        </div>
        <div class="mb-3">
          <label for="createRepairStatusDropdown" class="form-label">Trạng thái</label>
          <select id="createRepairStatusDropdown" class="form-select mb-3" required>
            <option value="opened">Mới tiếp nhận</option>
            <option value="in-progress">Đang sửa</option>
            <option value="completed">Hoàn tất</option>
            <option value="canceled">Hủy bỏ</option>
          </select>
        </div>
        <div class="mb-3">
          <label for="createRepairNote" class="form-label">Ghi chú</label>
          <textarea id="createRepairNote" class="form-control" rows="3" placeholder="Ghi chú thêm (nếu có)"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-success">💾 Tạo</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal sửa -->
<div class="modal fade" id="repairEditModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <form id="editRepairForm" class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Sửa phiếu sửa chữa</h5></div>
      <div class="modal-body">
        <div class="mb-3">
          <label for="editRepairId" class="form-label">Thiết bị</label>
          <input type="hidden" id="editRepairId" />
          <input type="hidden" id="editRepairDeviceId" />
          <input type="text" id="editRepairDeviceInfo" class="form-control mb-3" disabled />
        </div>
        <div class="mb-3">
          <label for="editRepairHardwareDropdown" class="form-label">Phần cứng</label>
          <select id="editRepairHardwareDropdown" class="form-select mb-3"></select>
        </div>
        <div class="mb-3">
          <label for="editRepairSenderText" class="form-label">Người gửi Thiết bị</label>
          <input id="editRepairSenderText" class="form-control my-3" />
        </div>
        <div class="mb-3">
          <label for="editRepairBrokenDate" class="form-label">Ngày hư hỏng</label>
          <input type="date" id="editRepairBrokenDate" class="form-control mb-3" required />
        </div>
        <div class="mb-3">
          <label for="editRepairReceiverDropdown" class="form-label">Người nhận sửa chữa</label>
          <select id="editRepairReceiverDropdown" class="form-select my-3"></select>
        </div>
        <div class="mb-3">
          <label for="editRepairRepairDate" class="form-label">Ngày sửa chữa</label>
          <input type="date" id="editRepairRepairDate" class="form-control mb-3" />
        </div>
        <div class="mb-3">
          <label for="editRepairStatusDropdown" class="form-label">Trạng thái</label>
          <select id="editRepairStatusDropdown" class="form-select mb-3" required>
            <option value="opened">Mới tiếp nhận</option>
            <option value="in-progress">Đang sửa</option>
            <option value="completed">Hoàn tất</option>
            <option value="canceled">Hủy bỏ</option>
          </select>
        </div>
        <textarea id="editRepairNote" class="form-control" rows="3" placeholder="Ghi chú thêm (nếu có)"></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn btn-warning">💾 Lưu</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal thông tin biểu mẫu sửa chữa -->
<div class="modal fade" id="repairReportDetailModal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <form id="repairReportDetailForm" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Thông tin biểu mẫu sửa chữa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="reportRepairId" />
        <datalist id="reportSurveyUserList"></datalist>

        <div class="alert alert-info small">
          Dữ liệu này dùng để in <strong>Phiếu đề nghị sửa chữa</strong> và
          <strong>Biên bản kiểm tra thiết bị</strong>.
          Trong Biên bản kiểm tra:
          <br />
          - “Kết quả kiểm tra” lấy từ “Mô tả tình trạng hư hỏng”.
          <br />
          - “Hướng khắc phục” lấy từ “Nội dung sửa chữa cụ thể”.
        </div>

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Ngày đưa vào sử dụng</label>
            <input type="date" name="deviceUseDate" id="reportDeviceUseDate" class="form-control" />
          </div>

          <div class="col-md-8">
            <label class="form-label">Mô tả tình trạng hư hỏng</label>
            <textarea name="damageDescription" id="reportDamageDescription" class="form-control" rows="2"></textarea>
          </div>

          <div class="col-12">
            <label class="form-label">Kết quả khảo sát</label>
            <textarea name="surveyResult" id="reportSurveyResult" class="form-control" rows="2"></textarea>
          </div>

          <div class="col-md-4">
            <label class="form-label">Người khảo sát 1</label>
            <input
              name="surveyPerson1Name"
              id="reportSurveyPerson1Name"
              class="form-control"
              list="reportSurveyUserList"
            />
          </div>

          <div class="col-md-2">
            <label class="form-label">Ngày khảo sát 1</label>
            <input type="date" name="surveyPerson1Date" id="reportSurveyPerson1Date" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Người khảo sát 2</label>
            <input
              name="surveyPerson2Name"
              id="reportSurveyPerson2Name"
              class="form-control"
              list="reportSurveyUserList"
            />
          </div>

          <div class="col-md-2">
            <label class="form-label">Ngày khảo sát 2</label>
            <input type="date" name="surveyPerson2Date" id="reportSurveyPerson2Date" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Người khảo sát 3</label>
            <input
              name="surveyPerson3Name"
              id="reportSurveyPerson3Name"
              class="form-control"
              list="reportSurveyUserList"
            />
          </div>

          <div class="col-md-2">
            <label class="form-label">Ngày khảo sát 3</label>
            <input type="date" name="surveyPerson3Date" id="reportSurveyPerson3Date" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Hình thức sửa chữa</label>
            <select name="repairMethod" id="reportRepairMethod" class="form-select">
              <option value="">-- Chọn --</option>
              <option value="internal">Nội bộ</option>
              <option value="external">Thuê ngoài</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Thời gian dự kiến (giờ)</label>
            <input type="number" step="0.5" name="expectedRepairHours" id="reportExpectedRepairHours" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Dự kiến từ lúc</label>
            <input name="expectedStartTime" id="reportExpectedStartTime" class="form-control" placeholder="Ví dụ: 08:00" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Dự kiến đến lúc</label>
            <input name="expectedEndTime" id="reportExpectedEndTime" class="form-control" placeholder="Ví dụ: 10:00" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Chi phí dự kiến</label>
            <input type="number" name="estimatedCost" id="reportEstimatedCost" class="form-control" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Thời gian thực tế (giờ)</label>
            <input type="number" step="0.5" name="actualRepairHours" id="reportActualRepairHours" class="form-control" />
          </div>

          <div class="col-md-2">
            <label class="form-label">Thực tế từ lúc</label>
            <input name="actualStartTime" id="reportActualStartTime" class="form-control" placeholder="Ví dụ: 08:00" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Thực tế đến lúc</label>
            <input name="actualEndTime" id="reportActualEndTime" class="form-control" placeholder="Ví dụ: 10:00" />
          </div>

          <div class="col-md-3">
            <label class="form-label">Kết quả sửa chữa</label>
            <select name="repairResult" id="reportRepairResult" class="form-select">
              <option value="">-- Chọn --</option>
              <option value="passed">Đạt</option>
              <option value="failed">Không đạt</option>
              <option value="other">Khác</option>
            </select>
          </div>

          <div class="col-md-9">
            <label class="form-label">Kết quả khác</label>
            <input name="repairResultOther" id="reportRepairResultOther" class="form-control" />
          </div>

          <div class="col-12">
            <label class="form-label">Nội dung sửa chữa cụ thể</label>
            <textarea name="repairContent" id="reportRepairContent" class="form-control" rows="2"></textarea>
          </div>

          <div class="col-md-3">
            <label class="form-label">Tình trạng hoạt động</label>
            <select name="operationStatus" id="reportOperationStatus" class="form-select">
              <option value="">-- Chọn --</option>
              <option value="passed">Đạt</option>
              <option value="failed">Không đạt</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Kết quả nghiệm thu</label>
            <select name="acceptanceResult" id="reportAcceptanceResult" class="form-select">
              <option value="">-- Chọn --</option>
              <option value="passed">Đạt</option>
              <option value="failed">Không đạt</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">Ghi chú nghiệm thu</label>
            <input name="acceptanceNote" id="reportAcceptanceNote" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Đại diện khoa/phòng sử dụng</label>
            <input name="departmentRepresentativeName" id="reportDepartmentRepresentativeName" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">TP.TC-KT</label>
            <input name="financeDeptHeadName" id="reportFinanceDeptHeadName" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">TP.HCQT-TCCB</label>
            <input name="adminDeptHeadName" id="reportAdminDeptHeadName" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Giám đốc</label>
            <input name="directorName" id="reportDirectorName" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Người thực hiện sửa chữa</label>
            <input name="repairTechnicianName" id="reportRepairTechnicianName" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Đại diện phòng CNTT</label>
            <input name="itRepresentativeName" id="reportItRepresentativeName" class="form-control" />
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-primary">💾 Lưu thông tin biểu mẫu</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/common/pagination.js"></script>
<script src="/js/repairs.js"></script>
</body>
</html>
