<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Quản lý thiết bị</title>
  
  <%- include('../partials/header') %>

  <div class="container mt-4">
    <h2 class="mb-3">Thiết bị</h2>

    <div id="deviceAlertContainer" class="mb-3"></div>
    <!-- 🔍 Form lọc -->
    <form id="filterForm" class="row g-2">
      <div class="col-6 col-md-2"><input name="code" class="form-control" placeholder="Mã thiết bị" /></div>
      <div class="col-6 col-md-2"><input name="name" class="form-control" placeholder="Tên thiết bị" /></div>
      <div class="col-6 col-md-2">
        <select name="deviceTypeId" class="form-control dropdown" id="deviceTypeDropdown">
          <option value="">-- Loại thiết bị --</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <select name="filter" class="form-control">
          <option value="all">Tất cả</option>
          <option value="active">Còn sử dụng</option>
          <option value="inactive">Tạm ngưng</option>
        </select>
      </div>
      <div class="col-6 col-md-2"><input type="date" name="startDate" class="form-control"></div>
      <div class="col-6 col-md-2"><input type="date" name="endDate" class="form-control"></div>
      <div class="col-6 col-md-12 text-end">
        <button class="btn btn-primary">Tìm kiếm</button>
        <button type="button" id="resetBtn" class="btn btn-secondary ms-2">Reset</button>
        <button type="button" class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#deviceModal">➕ Thêm</button>
      </div>
    </form>

    <!-- 📋 Bảng thiết bị -->
    <div id="deviceTable" class="table-responsive mt-4"></div>

    <!-- 📍 Phân trang -->
    <div id="pagination" class="mt-3 text-center"></div>
  </div>

  <!-- ✨ Modal Thêm thiết bị -->
  <div class="modal fade" id="deviceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <form id="createDeviceForm" class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Thêm thiết bị mới</h5></div>
        <div class="modal-body">
          <input name="code" class="form-control mb-2" placeholder="Mã thiết bị" required />
          <input name="name" class="form-control mb-2" placeholder="Tên thiết bị" required />
          <select name="deviceTypeId" class="form-control mb-2" id="modalDeviceType"></select>
          <input type="date" name="purchaseDate" class="form-control my-2" required />
          <input name="note" class="form-control mb-2" placeholder="Ghi chú" />
        </div>
        <div class="modal-footer">
          <button class="btn btn-success">Thêm</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ⚙️ Script -->
  <script src="/js/common/pagination.js"></script>
  <script src="/js/devices.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>