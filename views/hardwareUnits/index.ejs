<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Phần cứng chi tiết</title>
  
  <%- include('../partials/header') %>
  <div class="container mt-4">
    <h2 class="mb-3">Phần cứng chi tiết</h2>
    <div id="hardwareUnitAlertContainer" class="mb-3"></div>

    <!-- 🔍 Bộ lọc -->
    <form id="filterHardwareUnitForm" class="row g-2 mb-3">
      <div class="col-6 col-md-3"><input name="code" class="form-control" placeholder="Mã thiết bị" /></div>
      <div class="col-6 col-md-3"><input name="serialNumber" class="form-control" placeholder="Số seri" /></div>
      <div class="col-6 col-md-3">
        <!--
          Backend/service đang lọc theo filters.hardwareName (SP nhận pHardwareName dạng LIKE).
          Vì vậy dropdown filter sẽ gửi hardwareName (value = tên phần cứng).
        -->
        <select name="hardwareName" class="form-select" id="filterHardwareDropdown"></select>
      </div>
      <div class="col-6 col-md-3">
        <select name="filter" class="form-select">
          <option value="all">Tất cả</option>
          <option value="active">Còn sử dụng</option>
          <option value="inactive">Tạm ngưng</option>
        </select>
      </div>
      <div class="col-6 col-md-3"><input type="date" name="startDate" class="form-control" /></div>
      <div class="col-6 col-md-3"><input type="date" name="endDate" class="form-control" /></div>
      <div class="col-6 text-end">
        <button class="btn btn-primary">Tìm kiếm</button>
        <button type="button" id="resetHardwareUnitBtn" class="btn btn-secondary ms-2">Reset</button>
        <button type="button" class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#hardwareUnitModal">➕ Thêm</button>
      </div>
    </form>

    <!-- 📋 Bảng -->
    <div id="hardwareUnitTable" class="mt-4"></div>
    <div id="hardwareUnitPagination" class="mt-3 text-center"></div>
  </div>

  <!-- ➕ Modal thêm thiết bị -->
  <div class="modal fade" id="hardwareUnitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <form id="createHardwareUnitForm" class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Thêm thiết bị phần cứng</h5></div>
        <div class="modal-body">
          <input name="code" class="form-control mb-2" placeholder="Mã thiết bị" required />
          <input name="serialNumber" class="form-control mb-2" placeholder="Số seri" required />
          <select name="hardwareId" class="form-select mb-2" id="modalHardwareDropdown" required></select>
          <input type="date" name="purchaseDate" class="form-control my-2" required />
          <input name="note" class="form-control mb-2" placeholder="Ghi chú" />
        </div>
        <div class="modal-footer">
          <button class="btn btn-success">Thêm</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/common/pagination.js"></script>
  <script src="/js/hardwareUnits.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>